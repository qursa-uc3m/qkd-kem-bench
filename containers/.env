# Build-time arguments
OPENSSL_BRANCH=openssl-3.4.0
LIBOQS_BRANCH=0.12.0
OQSPROV_BRANCH=0.8.0
QKDKEMPROV_BRANCH=main
QKD_ETSI_API_BRANCH=main

# Runtime configuration
#DEFAULT_GROUPS=x25519:x448:kyber512:p256_kyber512:kyber768:p384_kyber768:kyber1024:p521_kyber1024
#DEFAULT_GROUPS=mlkem512:mlkem768:mlkem1024:
#DEFAULT_GROUPS=bikel1:mlkem512:mlkem768:mlkem1024:frodo640aes:frodo640shake:frodo976shake:hqc128:hqc192
DEFAULT_GROUPS=bikel1:mlkem512:mlkem768:mlkem1024:frodo640aes:frodo640shake:frodo976shake:hqc128:hqc192:qkd_bikel1:qkd_mlkem512:qkd_mlkem768:qkd_mlkem1024:qkd_frodo640aes:qkd_frodo640shake:qkd_frodo976shake:qkd_hqc128:qkd_hqc192
QKD_BACKEND=qukaydee
# Available backends: simulated, cerberis-xgr, qukaydee
ACCOUNT_ID="2507"

# Certificate configuration
SSL_CERT_DIR=mldsa
SSL_CERT_TYPE=mldsa44
# Available options: dilithium2, dilithium3, dilithium5, falcon512, falcon1024, etc.